# ==============================================================================
# PHOENIX Platform Environment Configuration
# ==============================================================================

# Server & Security
PROJECT_NAME="PHOENIX Autonomous Software Recovery Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (used when no Supabase/PostgreSQL is specified):
DATABASE_URL="sqlite:///./phoenix.db"
# Supabase PostgreSQL (Production connection pooler or direct):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==============================================================================
# Supabase Managed Platform (Database, Auth, Storage, Realtime)
# ==============================================================================
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=""
# Supabase Publishable / Anon Key (Safe for frontend)
SUPABASE_ANON_KEY=""
# Supabase Service Role Key (SERVER-ONLY - Never expose to frontend or logs)
SUPABASE_SERVICE_ROLE_KEY=""
# Supabase JWT Secret (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_JWT_SECRET=""

# Frontend Supabase Variables (for frontend/.env)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# AI Inference Provider (Groq)
# ==============================================================================
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
LLM_PROVIDER="groq"
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ==============================================================================
# GitHub Integration
# ==============================================================================
# Fine-grained Personal Access Token (PAT) with repo scope for automated repair PRs:
GITHUB_TOKEN=""
# GitHub App Configuration (Optional for production multi-tenant app):
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# ==============================================================================
# Execution Sandbox Limits
# ==============================================================================
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_NETWORK_ISOLATED=true
