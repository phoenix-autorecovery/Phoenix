# PHOENIX Environment Configuration Template

# Server Configuration
PROJECT_NAME="PHOENIX Autonomous Software Recovery Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite development default:
DATABASE_URL="sqlite:///./phoenix.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://phoenix:phoenixpassword@localhost:5432/phoenix_db"

# Background Job Queue
# Optional: REDIS_URL="redis://localhost:6379/0"

# AI Inference Provider (Groq)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
LLM_PROVIDER="groq"
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# GitHub Integration
GITHUB_TOKEN=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Sandbox Execution Limits
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_NETWORK_ISOLATED=true
